# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# A Game Server Login Token for app id 730, from
# https://steamcommunity.com/dev/managegameservers
#
# ITS OWN token: one drives one server only, and a token shared with another
# CS2 server logs both out. Workshop downloads also require it - without one
# the collection never arrives and the server starts on whatever it has.
CS2_CLASSIC_SERVER_STEAM_TOKEN=

# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
CS2_CLASSIC_SERVER_RCON_PASSWORD=

# The Steam Workshop collection id: the number at the end of the collection's
# URL on steamcommunity.com. Make your own with the remakes you want - Assault,
# Militia, Dust, Aztec, Tuscan and the rest are all there - and list the ones
# to rotate in mapcycle.txt by their map name.
CS2_CLASSIC_SERVER_WORKSHOP_COLLECTION=

# ---------------------------------------------------------------- the server
CS2_CLASSIC_SERVER_NAME=CS2 Classic Maps
# Leave empty for a public server; set it to require a password to join.
CS2_CLASSIC_SERVER_PASSWORD=
CS2_CLASSIC_SERVER_MAX_PLAYERS=10
CS2_CLASSIC_SERVER_GAME_ALIAS=casual
# The workshop map to start on, by its file id. Empty: the first in the collection.
CS2_CLASSIC_SERVER_WORKSHOP_START_MAP=

# Bots fill the room to this total and step aside as humans join. Difficulty
# 0 easy .. 3 expert. Workshop mode may refuse these at map change; see
# scripts/botguard.sh in the README.
CS2_CLASSIC_SERVER_BOT_QUOTA=8
CS2_CLASSIC_SERVER_BOT_QUOTA_MODE=fill
CS2_CLASSIC_SERVER_BOT_DIFFICULTY=2

# ---------------------------------------------------------------- networking
# Game, query and rcon port, published under the same number on purpose:
# Steam's list records the port the server BINDS. Next to a plain CS2 server
# on the same host, give this one another number - 27019 - and both sides of
# the mapping carry it.
CS2_CLASSIC_SERVER_PORT=27015

CS2_CLASSIC_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# CS2_CLASSIC_SERVER_IMAGE_VERSION=<version>@sha256:<digest>
# CS2_CLASSIC_SERVER_IMAGE_TAG=joedwards32/cs2:<version>
#
# 6g: resident stays under 1 GB; the 14 GB peak once recorded was SteamCMD's
# page cache during an update, which a limit reclaims rather than kills.
# CS2_CLASSIC_SERVER_MEMORY_LIMIT=6g
# CS2_CLASSIC_SERVER_CPU_LIMIT=2.0
# CS2_CLASSIC_SERVER_MEMORY_RESERVATION=1g
# CS2_CLASSIC_SERVER_CPU_RESERVATION=0.5
#
# First boot downloads roughly 60 GB through SteamCMD, then the collection.
# CS2_CLASSIC_SERVER_START_PERIOD=90m
# CS2_CLASSIC_SERVER_STOP_GRACE_PERIOD=30s
#
# Added upstream in 5.0.0, both with the image's own defaults, so leaving them
# alone changes nothing. The first is how strictly the server enforces its
# delta-tick budget; the second is whether GOTV relays player voice, which is
# worth turning off where recording voice is a privacy question rather than a
# feature.
# CS2_CLASSIC_SERVER_DELTATICKS_ENFORCE=2
# CS2_CLASSIC_SERVER_TV_RELAYVOICE=1
# CS2_CLASSIC_SERVER_LOG=on
# CS2_CLASSIC_SERVER_LOG_ECHO=1
# CS2_CLASSIC_SERVER_LOG_MAX_SIZE=10m
# CS2_CLASSIC_SERVER_LOG_MAX_FILE=3
